# Local backend defaults. Never commit real values.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# Leave DATABASE_URL empty locally to use SQLite.
DATABASE_URL=

# Required for real Gmail delivery. Local DEBUG mode uses the console backend if empty.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

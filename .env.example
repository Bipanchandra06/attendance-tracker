# Local backend defaults. Never commit real values.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# Gmail SMTP. Leave blank locally to use Django's console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Required by the GitHub Actions scheduler in production.
SCHEDULER_SECRET=
